PORT=5000
CLIENT_URL=http://localhost:5173

# Groq API — https://console.groq.com/keys (free tier, no card required to start)
# Key format starts with gsk_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Firebase Admin credentials — from Firebase Console > Project Settings >
# Service Accounts > Generate new private key (a JSON file downloads).
# Copy the matching fields from that JSON here:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
